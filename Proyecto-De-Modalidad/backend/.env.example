# Puerto en el que corre el backend (Render/Railway asigna PORT automáticamente)
PORT=3001

# Conexión a PostgreSQL (Supabase, Neon, Railway, Render, Docker o local)
# Ejemplo Local/Docker:
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/mundilex?schema=public"
# Ejemplo Supabase / Neon:
# DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?schema=public"

# URL del Frontend permitida para CORS (opcional, default: *)
FRONTEND_URL=

