<?xml version="1.0" encoding="utf-8"?>
<!--
    button_3d_pressed.xml
    Estado PRESIONADO del botón infantil estilo Claymorphism / Plastilina 3D.
    - El botón simula hundirse reduciendo su sombra exterior
    - El cuerpo se desplaza hacia abajo (top aumenta, bottom disminuye)
    - El gradiente se oscurece ligeramente para dar sensación de presión
    - El brillo superior se atenúa
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1) Sombra exterior reducida (botón hundido) -->
    <item
        android:left="2dp"
        android:right="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#0A000000" />
            <corners android:radius="26dp" />
        </shape>
    </item>

    <!-- 2) Cuerpo desplazado hacia abajo (simula hundimiento) -->
    <item
        android:top="6dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FF8A65"
                android:centerColor="#F4511E"
                android:endColor="#D84315"
                android:angle="270"
                android:type="linear" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1.5dp"
                android:color="#FFCC80" />
        </shape>
    </item>

    <!-- 3) Brillo superior atenuado -->
    <item
        android:top="8dp"
        android:left="6dp"
        android:right="6dp"
        android:bottom="6dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#40FFFFFF"
                android:centerColor="#1AFFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="90"
                android:type="linear" />
            <corners android:radius="18dp" />
        </shape>
    </item>

</layer-list>
