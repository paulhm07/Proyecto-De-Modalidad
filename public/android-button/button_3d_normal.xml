<?xml version="1.0" encoding="utf-8"?>
<!--
    button_3d_normal.xml
    Estado NORMAL del botón infantil estilo Claymorphism / Plastilina 3D.
    - Esquinas muy redondeadas (24dp)
    - Gradiente cálido y llamativo (naranja -> coral)
    - Sombra externa inferior que da relieve
    - Brillo superior interno para efecto plástico
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1) Sombra exterior difuminada (base del relieve) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1F000000" />
            <corners android:radius="28dp" />
        </shape>
    </item>

    <!-- 2) Capa intermedia de sombra desplazada hacia abajo -->
    <item
        android:top="2dp"
        android:left="2dp"
        android:right="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#14000000" />
            <corners android:radius="26dp" />
        </shape>
    </item>

    <!-- 3) Cuerpo principal del botón con gradiente vibrante -->
    <item
        android:top="2dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="6dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFAB40"
                android:centerColor="#FF6E40"
                android:endColor="#F4511E"
                android:angle="270"
                android:type="linear" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1.5dp"
                android:color="#FFE0B2" />
        </shape>
    </item>

    <!-- 4) Brillo superior interno (efecto plastilina brillante) -->
    <item
        android:top="4dp"
        android:left="6dp"
        android:right="6dp"
        android:bottom="12dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#80FFFFFF"
                android:centerColor="#33FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="90"
                android:type="linear" />
            <corners android:radius="20dp" />
        </shape>
    </item>

</layer-list>
