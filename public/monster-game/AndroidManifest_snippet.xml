<?xml version="1.0" encoding="utf-8"?>
<!--
    AndroidManifest.xml (fragmento)
    Declarar la Activity y los permisos de vibración.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.educaplay.monstermath">

    <!-- Permiso necesario para la vibración en fallos -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Alimenta al Monstruo"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <activity
            android:name=".FeedMonsterActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
