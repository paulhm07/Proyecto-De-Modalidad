<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_feed_monster.xml
    Minijuego "Alimenta al Monstruo" - Matemáticas 3er grado
    Layout con áreas de origen (respuestas) y destino (monstruo) bien definidas.

    Estructura:
    1) Header: puntuación y progreso
    2) Zona del monstruo (DROP TARGET) - área donde se suelta la respuesta
    3) Pregunta matemática (centro)
    4) Zona de respuestas (DRAG SOURCE) - 3 botones arrastrables
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_game_gradient">

    <!-- ===== HEADER: Puntuación y ronda ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="#80FFFFFF">

        <TextView
            android:id="@+id/tvScore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⭐ 0"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#F59E0B" />

        <TextView
            android:id="@+id/tvRound"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ronda: 1/10"
            android:textSize="16sp"
            android:textColor="#6B7280"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvLives"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="❤️❤️❤️"
            android:textSize="18sp"
            android:gravity="end" />
    </LinearLayout>

    <!-- ===== ZONA DEL MONSTRUO (DROP TARGET) ===== -->
    <!--
        FrameLayout con ID dragTargetMonster.
        OnDragListener se asigna a este contenedor para detectar el soltado.
    -->
    <FrameLayout
        android:id="@+id/dragTargetMonster"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:padding="24dp">

        <!-- Personaje monstruo (boca abierta) -->
        <ImageView
            android:id="@+id/ivMonster"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center"
            android:src="@drawable/monster_hungry"
            android:contentDescription="Monstruo hambriento esperando comida" />

        <!-- Burbuja de diálogo del monstruo -->
        <TextView
            android:id="@+id/tvMonsterSpeech"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="16dp"
            android:text="¡Tengo hambre! 🤤"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/speech_bubble"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp" />
    </FrameLayout>

    <!-- ===== PREGUNTA MATEMÁTICA ===== -->
    <TextView
        android:id="@+id/tvQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="24 ÷ 3 = ?"
        android:textSize="42sp"
        android:textStyle="bold"
        android:textColor="#1F2937"
        android:gravity="center"
        android:padding="16dp"
        android:background="#CCFFFFFF"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="16dp" />

    <!-- ===== ZONA DE RESPUESTAS (DRAG SOURCE) ===== -->
    <!--
        LinearLayout horizontal con 3 botones arrastrables.
        Cada botón tiene OnTouchListener asignado en Kotlin.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.5"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="center"
        android:weightSum="3">

        <Button
            android:id="@+id/btnAnswer1"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:text="6"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_answer_selector"
            android:stateListAnimator="@null"
            android:elevation="0dp" />

        <Button
            android:id="@+id/btnAnswer2"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:text="8"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_answer_selector"
            android:stateListAnimator="@null"
            android:elevation="0dp" />

        <Button
            android:id="@+id/btnAnswer3"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:text="9"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_answer_selector"
            android:stateListAnimator="@null"
            android:elevation="0dp" />
    </LinearLayout>

    <!-- ===== Feedback visual ===== -->
    <TextView
        android:id="@+id/tvFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="8dp" />

</LinearLayout>
